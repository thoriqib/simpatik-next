# ── Supabase ──────────────────────────────────────────────────
# Ambil dari Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxx...

# HANYA untuk server/script (seed-users.ts), JANGAN pernah dipakai
# di client component atau dikirim ke browser.
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxx...

# ── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="Simpatik"
NEXT_PUBLIC_APP_URL=http://localhost:3000
TZ=Asia/Jakarta

# ── Email (Resend) ────────────────────────────────────────────
# Dipakai untuk kirim link lacak permintaan data ke email pengunjung.
# Daftar gratis di resend.com, buat API key, lalu isi di bawah.
# Kalau dikosongkan, email otomatis dilewati (tidak error) — link
# tetap ditampilkan langsung di layar sebagai jalur utama.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Simpatik BPS Kota Jambi <onboarding@resend.dev>"
