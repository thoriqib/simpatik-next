# ── Supabase ──────────────────────────────────────────────────
# Ambil dari Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxx...

# HANYA untuk server/script (seed-users.ts), JANGAN pernah dipakai
# di client component atau dikirim ke browser.
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxx...

# ── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="Simpatik"
NEXT_PUBLIC_APP_URL=http://localhost:3000
TZ=Asia/Jakarta



# ── Captcha Cloudflare Turnstile (gratis) ─────────────────────
# Buat widget di https://dash.cloudflare.com → Turnstile. Kosongkan keduanya = captcha nonaktif.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
