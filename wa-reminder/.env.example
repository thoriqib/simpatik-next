# Sama dengan yang dipakai Simpatik di Vercel
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=isi-service-role-key

# Jam kirim (WIB). Default: setiap hari pukul 07:00
CRON_JADWAL=0 7 * * *

# Jeda acak antar pesan (detik) supaya tidak terlihat seperti spam otomatis
JEDA_MIN_DETIK=6
JEDA_MAX_DETIK=14

# Opsional: nomor admin yang dikabari ringkasan hasil kirim tiap pagi (format 62xxxxxxxxxx)
NOMOR_ADMIN_RINGKASAN=
